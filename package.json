{
  "name": "circlekey",
  "version": "1.0.0",
  "description": "Reference TypeScript implementation of the GroupVault Protocol — end-to-end encrypted group data storage for small teams with a zero-knowledge backend.",
  "license": "MPL-2.0",
  "homepage": "https://circlekey.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarthorizon-labs/circlekey.git"
  },
  "bugs": {
    "url": "https://github.com/smarthorizon-labs/circlekey/issues"
  },
  "keywords": [
    "end-to-end-encryption",
    "e2ee",
    "groupvault",
    "zero-knowledge",
    "cryptography"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/webcrypto": {
      "types": "./dist/adapters/webcrypto.d.ts",
      "import": "./dist/adapters/webcrypto.js"
    },
    "./adapters/indexeddb": {
      "types": "./dist/adapters/indexeddb.d.ts",
      "import": "./dist/adapters/indexeddb.js"
    },
    "./adapters/locks": {
      "types": "./dist/adapters/locks.d.ts",
      "import": "./dist/adapters/locks.js"
    },
    "./adapters/hints": {
      "types": "./dist/adapters/hints.d.ts",
      "import": "./dist/adapters/hints.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.8.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "hash-wasm": "^4.12.0"
  }
}
